{
  "source": {
    "include": [
      "controllers",
      "services",
      "repositories",
      "models",
      "middlewares",
      "routes"
    ],
    "includePattern": ".+\\.js$",
    "excludePattern": "(node_modules/|docs/)"
  },
  "plugins": ["plugins/markdown"],
  "opts": {
    "destination": "./docs/api",
    "recurse": true
  },
  "templates": {
    "cleverLinks": false,
    "monospaceLinks": false
  }
}

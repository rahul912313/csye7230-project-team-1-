{
  "source": {
    "include": [
      "controllers",
      "services",
      "repositories",
      "middlewares",
      "models",
      "db.js",
      "index.js"
    ],
    "exclude": ["node_modules", "__tests__", "coverage"],
    "includePattern": ".+\\.js$"
  },
  "opts": {
    "destination": "./docs/api",
    "recurse": true,
    "readme": "./README.md"
  },
  "plugins": ["plugins/markdown"],
  "templates": {
    "cleverLinks": false,
    "monospaceLinks": false
  },
  "metadata": {
    "title": "QuickRent API Documentation"
  }
}
